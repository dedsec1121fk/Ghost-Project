ll}, {"display_name": "wifi", "id": "eef1cdbc-590b-4e28-818d-226632a118d8", "name": "wifi", "state": "active", "vocabulary_id": null}, {"display_name": "\u03ad\u03be\u03c5\u03c0\u03bd\u03b7-\u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac", "id": "32effd68-ec63-435a-bd27-34a732391f1c", "name": "\u03ad\u03be\u03c5\u03c0\u03bd\u03b7-\u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac", "state": "active", "vocabulary_id": null}], "temporal_coverage": [{"end": "2026-10-03", "start": "2026-01-27"}], "groups": [], "relationships_as_subject": [], "relationships_as_object": [], "tracking_summary": {"total": 8, "recent": 1}}, {"access_rights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC", "applicable_legislation": ["http://data.europa.eu/eli/reg_impl/2023/138/oj", "https://eur-lex.europa.eu/eli/dir/2019/1024/oj/eng"], "author": null, "author_email": null, "creator_user_id": "c4e499cc-48d8-4630-b221-883b9d009d9d", "dcat_type": ["http://publications.europa.eu/resource/authority/dataset-type/HVD", "http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"], "frequency": "http://publications.europa.eu/resource/authority/frequency/DAILY", "hvd_category": ["http://data.europa.eu/bna/c_b79e35eb", "http://data.europa.eu/bna/c_e1da4e07"], "id": "2cbe13ce-7e7c-41bb-bd7f-abcd1651a634", "isopen": false, "language_options": ["http://publications.europa.eu/resource/authority/language/ELL", "http://publications.europa.eu/resource/authority/language/ENG"], "license_id": null, "license_title": null, "maintainer": null, "maintainer_email": null, "metadata_created": "2026-03-31T08:34:26.346379", "metadata_modified": "2026-10-04T02:19:24.173408", "name": "wifi-highest-visitors-108-athlitiko-kentro-mitsaki-kai-parko-tsepis", "notes": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2\u00bb (station_id: 108) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u039a\u03a5\u03a0\u03a1\u0399\u0391\u0394\u039f\u03a5. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "notes_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2\u00bb (station_id: 108) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u039a\u03a5\u03a0\u03a1\u0399\u0391\u0394\u039f\u03a5. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00abAthlitiko Kentro Mitsaki Kai Parko Tsepis\u00bb (station_id: 108) in the \u039a\u03a5\u03a0\u03a1\u0399\u0391\u0394\u039f\u03a5 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "num_resources": 2, "num_tags": 5, "organization": {"id": "6d8ca7d0-480a-470e-aec1-40152a8f1770", "name": "dimos-athinaion", "title": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "type": "organization", "description": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "image_url": "2025-12-09-202327.889418athens-logo.png", "created": "2025-12-03T09:03:43.703476", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "6d8ca7d0-480a-470e-aec1-40152a8f1770", "private": false, "state": "active", "theme": ["http://publications.europa.eu/resource/authority/data-theme/REGI", "http://publications.europa.eu/resource/authority/data-theme/SOCI", "http://publications.europa.eu/resource/authority/data-theme/TECH"], "title": "WiFi \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 \u2014 \u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2", "title_translated": {"el": "WiFi \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 \u2014 \u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2", "en": "WiFi Highest Visitors \u2014 Athlitiko Kentro Mitsaki Kai Parko Tsepis"}, "type": "dataset", "url": null, "resources": [{"access_url": "https://opendata.cityofathens.gr/dataset/wifi-highest-visitors-108-athlitiko-kentro-mitsaki-kai-parko-tsepis/resource/67ccd9a7-3a93-49cc-aac4-bba460bd2ea7", "archiver": {"resource_timestamp": null, "status_id": 21, "is_broken": null, "reason": "Resource has no URL", "url_redirected_to": null, "cache_filepath": null, "cache_url": null, "size": 0, "mimetype": null, "hash": null, "etag": null, "last_modified": null, "first_failure": "2026-03-31T08:34:34.719963", "last_success": null, "failure_count": 225, "created": "2026-03-31T08:34:34.725622", "updated": "2026-10-04T02:16:03.392690", "status": "Chose not to download", "is_broken_printable": "Not sure if broken"}, "availability": "http://publications.europa.eu/resource/authority/planned-availability/STABLE", "cache_last_updated": null, "cache_url": null, "created": "2026-03-31T08:34:26.349051", "datastore_active": true, "datastore_contains_all_records_of_source_file": false, "description": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2\u00bb (station_id: 108) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u039a\u03a5\u03a0\u03a1\u0399\u0391\u0394\u039f\u03a5. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "description_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2\u00bb (station_id: 108) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u039a\u03a5\u03a0\u03a1\u0399\u0391\u0394\u039f\u03a5. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00abAthlitiko Kentro Mitsaki Kai Parko Tsepis\u00bb (station_id: 108) in the \u039a\u03a5\u03a0\u03a1\u0399\u0391\u0394\u039f\u03a5 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "download_url": "https://opendata.cityofathens.gr/datastore/dump/67ccd9a7-3a93-49cc-aac4-bba460bd2ea7", "format": "JSON", "hash": "", "id": "67ccd9a7-3a93-49cc-aac4-bba460bd2ea7", "language_options": ["http://publications.europa.eu/resource/authority/language/ELL", "http://publications.europa.eu/resource/authority/language/ENG"], "last_modified": null, "license": "http://publications.europa.eu/resource/authority/licence/CC_BY_4_0", "metadata_modified": "2026-10-04T02:19:24.182455", "mimetype": "https://www.iana.org/assignments/media-types/application/json", "mimetype_inner": null, "name": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 \u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2", "name_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 \u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u039a\u03ad\u03bd\u03c4\u03c1\u03bf \u039c\u03b7\u03c4\u03c3\u03ac\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03ac\u03c1\u03ba\u03bf \u03a4\u03c3\u03ad\u03c0\u03b7\u03c2", "en": "Daily Highest Visitors \u2014 Athlitiko Kentro Mitsaki Kai Parko Tsepis"}, "package_id": "2cbe13ce-7e7c-41bb-bd7f-abcd1651a634", "position": 0, "qa": {"resource_timestamp": null, "archival_timestamp": "2026-05-28T02:18:03.357456", "openness_score": 0, "openness_score_reason": "Resource has open license: http://publications.europa.eu/resource/authority/licence/CC_BY_4_0", "format": null, "mqa_score": "66.7", "mqa_findability_score": 100, "mqa_accessibility_score": "20.0", "mqa_interoperability_score": "80.0", "mqa_reusability_score": "55.0", "mqa_contextuality_score": "15.0", "created": "2026-03-31T08:34:30.28987