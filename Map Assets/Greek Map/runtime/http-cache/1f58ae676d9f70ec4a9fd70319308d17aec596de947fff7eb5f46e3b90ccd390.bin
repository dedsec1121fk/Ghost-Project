7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "description_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab7\u03bf \u0394\u03b7\u03bc\u03bf\u03c4\u03b9\u03ba\u03cc \u0394\u03b9\u03b1\u03bc\u03ad\u03c1\u03b9\u03c3\u03bc\u03b1 \u0394\u03ae\u03bc\u03bf\u03c5 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd\u00bb (station_id: 102) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u0391\u0392\u0395\u03a1\u03a9\u03a6 \u0399\u0399. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00ab7O Dimotiko Diamerisma Dimoy Athinaion\u00bb (station_id: 102) in the \u0391\u0392\u0395\u03a1\u03a9\u03a6 \u0399\u0399 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "download_url": "https://opendata.cityofathens.gr/datastore/dump/90f02469-6030-4263-aec8-1646036a77a2", "format": "JSON", "hash": "", "id": "90f02469-6030-4263-aec8-1646036a77a2", "language_options": ["http://publications.europa.eu/resource/authority/language/ELL", "http://publications.europa.eu/resource/authority/language/ENG"], "last_modified": null, "license": "http://publications.europa.eu/resource/authority/licence/CC_BY_4_0", "metadata_modified": "2026-10-04T02:18:55.747890", "mimetype": "https://www.iana.org/assignments/media-types/application/json", "mimetype_inner": null, "name": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 7\u03bf \u0394\u03b7\u03bc\u03bf\u03c4\u03b9\u03ba\u03cc \u0394\u03b9\u03b1\u03bc\u03ad\u03c1\u03b9\u03c3\u03bc\u03b1 \u0394\u03ae\u03bc\u03bf\u03c5 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "name_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 7\u03bf \u0394\u03b7\u03bc\u03bf\u03c4\u03b9\u03ba\u03cc \u0394\u03b9\u03b1\u03bc\u03ad\u03c1\u03b9\u03c3\u03bc\u03b1 \u0394\u03ae\u03bc\u03bf\u03c5 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "en": "Daily Highest Visitors \u2014 7O Dimotiko Diamerisma Dimoy Athinaion"}, "package_id": "30a1924f-fe4d-441d-9a3c-6ddd53ae8dfe", "position": 0, "qa": {"resource_timestamp": null, "archival_timestamp": "2026-05-28T02:17:34.931279", "openness_score": 0, "openness_score_reason": "Resou