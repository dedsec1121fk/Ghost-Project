ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "description_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u0393\u03ae\u03c0\u03b5\u03b4\u03bf \u0395\u03b8\u03bd\u03b9\u03ba\u03bf\u03cd \u0395\u03bb\u03bb\u03b7\u03bd\u03bf\u03c1\u03ce\u03c3\u03c9\u03bd\u00bb (station_id: 22) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u0395\u039b\u039b\u0397\u039d\u039f\u03a1\u03a9\u03a3\u03a9\u039d \u0399. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00abGipedo Ethnikoy Ellinoroson\u00bb (station_id: 22) in the \u0395\u039b\u039b\u0397\u039d\u039f\u03a1\u03a9\u03a3\u03a9\u039d \u0399 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "download_url": "https://opendata.cityofathens.gr/datastore/dump/25a4aa4c-32f3-49fd-9371-7400002f6fce", "format": "JSON", "hash": "", "id": "25a4aa4c-32f3-49fd-9371-7400002f6fce", "language_options": ["http://publications.europa.eu/resource/authority/language/ELL", "http://publications.europa.eu/resource/authority/language/ENG"], "last_modified": null, "license": "http://publications.europa.eu/resource/authority/licence/CC_BY_4_0", "metadata_modified": "2026-10-04T02:15:08.464790", "mimetype": "https://www.iana.org/assignments/media-types/application/json", "mimetype_inner": null, "name": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 \u0393\u03ae\u03c0\u03b5\u03b4\u03bf \u0395\u03b8\u03bd\u03b9\u03ba\u03bf\u03cd \u0395\u03bb\u03bb\u03b7\u03bd\u03bf\u03c1\u03ce\u03c3\u03c9\u03bd", "name_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 \u0393\u03ae\u03c0\u03b5\u03b4\u03bf \u0395\u03b8\u03bd\u03b9\u03ba\u03bf\u03cd \u0395\u03bb\u03bb\u03b7\u03bd\u03bf\u03c1\u03ce\u03c3\u03c9\u03bd", "en": "Daily Highest Visitors \u2014 Gipedo Ethnikoy Ellinoroson"}, "package_id": "3164f2c3-9bf7-4db0-b46c-b59523295c9c", "position": 0, "qa": {"resource_timestamp": null, "archival_timestamp": "2026-05-28T02:13:54.231632", 