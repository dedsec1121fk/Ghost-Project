vocabulary_id": null}, {"display_name": "\u03ad\u03be\u03c5\u03c0\u03bd\u03b7-\u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac", "id": "32effd68-ec63-435a-bd27-34a732391f1c", "name": "\u03ad\u03be\u03c5\u03c0\u03bd\u03b7-\u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac", "state": "active", "vocabulary_id": null}], "temporal_coverage": [{"end": "2026-10-03", "start": "2025-10-29"}], "groups": [], "relationships_as_subject": [], "relationships_as_object": [], "tracking_summary": {"total": 103, "recent": 23}}, {"access_rights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC", "applicable_legislation": ["http://data.europa.eu/eli/reg_impl/2023/138/oj", "https://eur-lex.europa.eu/eli/dir/2019/1024/oj/eng"], "author": null, "author_email": null, "creator_user_id": "c4e499cc-48d8-4630-b221-883b9d009d9d", "dcat_type": ["http://publications.europa.eu/resource/authority/dataset-type/HVD", "http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"], "frequency": "http://publications.europa.eu/resource/authority/frequency/DAILY", "hvd_category": ["http://data.europa.eu/bna/c_b79e35eb", "http://data.europa.eu/bna/c_e1da4e07"], "id": "b2f6aff3-1ed1-4017-bc45-230169bc18eb", "isopen": false, "language_options": ["http://publications.europa.eu/resource/authority/language/ELL", "http://publications.europa.eu/resource/authority/language/ENG"], "license_id": null, "license_title": null, "maintainer": null, "maintainer_email": null, "metadata_created": "2026-03-31T08:36:04.999496", "metadata_modified": "2026-10-04T02:19:48.135516", "name": "wifi-highest-visitors-113-fokionos-negri", "notes": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u03a6\u03c9\u03ba\u03af\u03c9\u03bd\u03bf\u03c2 \u039d\u03ad\u03b3\u03c1\u03b7\u00bb (station_id: 113) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u03a6\u03a9\u039a\u0399\u03a9\u039d\u039f\u03a3 \u039d\u0395\u0393\u03a1\u0397. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "notes_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u03a6\u03c9\u03ba\u03af\u03c9\u03bd\u03bf\u03c2 \u039d\u03ad\u03b3\u03c1\u03b7\u00bb (station_id: 113) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u03a6\u03a9\u039a\u0399\u03a9\u039d\u039f\u03a3 \u039d\u0395\u0393\u03a1\u0397. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00abFokionos Negri\u00bb (station_id: 113) in the \u03a6\u03a9\u039a\u0399\u03a9\u039d\u039f\u03a3 \u039d\u0395\u0393\u03a1\u0397 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "num_resources": 2, "num_tags": 5, "organization": {"id": "6d8ca7d0-480a-470e-aec1-40152a8f1770", "name": "dimos-athinaion", "title": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "type": "organization", "description": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "image_url": "2025-12-09-202327.889418athens-logo.png", "created": "2025-12-03T09:03:43.703476", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "6d8ca7d0-480a-470e-aec1-40152a8f1770", "private": false, "state": "active", "theme": ["http://publications.europa.eu/resource/authority/data-theme/REGI", "http://publications.europa.eu/resource/authority/data-theme/SOCI", "http://publications.europa.eu/resource/authority/data-theme/TECH"], "title": "WiFi \u039c\u0