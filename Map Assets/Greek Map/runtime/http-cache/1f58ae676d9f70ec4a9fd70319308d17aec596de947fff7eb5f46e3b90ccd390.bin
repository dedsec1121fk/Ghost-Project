03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "notes_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u03a0\u03ac\u03c1\u03ba\u03bf - \u03a0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03a0\u03b1\u03bb\u03bf\u03c5\u03bc\u03c0\u03b9\u03ce\u03c4\u03b7\u00bb (station_id: 25) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u03a4\u039f\u03a5\u03a1\u039a\u039f\u0392\u039f\u03a5\u039d\u0399\u0391. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00abParko Plateia Paloympioti\u00bb (station_id: 25) in the \u03a4\u039f\u03a5\u03a1\u039a\u039f\u0392\u039f\u03a5\u039d\u0399\u0391 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "num_resources": 2, "num_tags": 5, "organization": {"id": "6d8ca7d0-480a-470e-aec1-40152a8f1770", "name": "dimos-athinaion", "title": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "type": "organization", "description": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd", "image_url": "2025-12-09-202327.889418athens-logo.png", "created": "2025-12-03T09:03:43.703476", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "6d8ca7d0-480a-470e-aec1-40152a8f1770", "private": false, "state": "active", "theme": ["http://publications.europa.eu/resource/authority/data-theme/REGI", "http://publications.europa.eu/resource/authority/data-theme/SOCI", "http://publications.europa.eu/resource/authority/data-theme/TECH"], "title": "WiFi \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 \u2014 \u03a0\u03ac\u03c1\u03ba\u03bf - \u03a0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03a0\u03b1\u03bb\u03bf\u03c5\u03bc\u03c0\u03b9\u03ce\u03c4\u03b7", "title_translated": {"el": "WiFi \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 \u2014 \u03a0\u03ac\u03c1\u03ba\u03bf - \u03a0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03a0\u03b1\u03bb\u03bf\u03c5\u03bc\u03c0\u03b9\u03ce\u03c4\u03b7", "en": "WiFi Highest Visitors \u2014 Parko Plateia Paloympioti"}, "type": "dataset", "url": null, "resources": [{"access_url": "https://opendata.cityofathens.gr/dataset/wifi-highest-visitors-025-parko-plateia-paloympioti/resource/7f30cc59-8024-451e-9e69-10a6a7103134", "archiver": {"resource_timestamp": null, "status_id": 21, "is_broken": null, "reason": "Resource has no URL", "url_redirected_to": null, "cache_filepath": null, "cache_url": null, "size": 0, "mimetype": null, "hash": null, "etag": null, "last_modified": null, "first_failure": "2026-03-31T08:18:22.104028", "last_success": null, "failure_count": 225, "created": "2026-03-31T08:18:22.110833", "updated": "2026-10-04T02:14:45.904579", "status": "Chose not to download", "is_broken_printable": "Not sure if broken"}, "availability": "http://publications.europa.eu/resource/authority/planned-availability/STABLE", "cache_last_updated": null, "cache_url": null, "created": "2026-03-31T08:18:13.755657", "datastore_active": true, "datastore_contains_all_records_of_source_file": false, "description": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u03a0\u03ac\u03c1\u03ba\u03bf - \u03a0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03a0\u03b1\u03bb\u03bf\u03c5\u03bc\u03c0\u03b9\u03ce\u03c4\u03b7\u00bb (station_id: 25) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u03a4\u039f\u03a5\u03a1\u039a\u039f\u0392\u039f\u03a5\u039d\u0399\u0391. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "description_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c0\u03c4\u03ce\u03bd (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1) \u03c3\u03c4\u03bf\u03bd \u03c3\u03c4\u03b1\u03b8\u03bc\u03cc \u00ab\u03a0\u03ac\u03c1\u03ba\u03bf - \u03a0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03a0\u03b1\u03bb\u03bf\u03c5\u03bc\u03c0\u03b9\u03ce\u03c4\u03b7\u00bb (station_id: 25) \u03c3\u03c4\u03b7 \u03b3\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac \u03a4\u039f\u03a5\u03a1\u039a\u039f\u0392\u039f\u03a5\u039d\u0399\u0391. \u0391\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af \u03c3\u03c4\u03bf \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03ce\u03bd MAC addresses \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b1 Access Points \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2. \u03a0\u03b7\u03b3\u03ae: API \u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ce\u03bd \u03a5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u0388\u03be\u03c5\u03c0\u03bd\u03b7\u03c2 \u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac\u03c2 (\u03a5\u03c0\u03bf\u03ad\u03c1\u03b3\u03bf 3, NOVA ICT).", "en": "Daily total of unique visitors (highest visitors) at station \u00abParko Plateia Paloympioti\u00bb (station_id: 25) in the \u03a4\u039f\u03a5\u03a1\u039a\u039f\u0392\u039f\u03a5\u039d\u0399\u0391 neighbourhood. Represents the total unique MAC addresses detected by the station's Access Points throughout the day. Source: Smart Neighbourhood Digital Services API (Sub-project 3, NOVA ICT)."}, "download_url": "https://opendata.cityofathens.gr/datastore/dump/7f30cc59-8024-451e-9e69-10a6a7103134", "format": "JSON", "hash": "", "id": "7f30cc59-8024-451e-9e69-10a6a7103134", "language_options": ["http://publications.europa.eu/resource/authority/language/ELL", "http://publications.europa.eu/resource/authority/language/ENG"], "last_modified": null, "license": "http://publications.europa.eu/resource/authority/licence/CC_BY_4_0", "metadata_modified": "2026-10-04T02:15:22.308581", "mimetype": "https://www.iana.org/assignments/media-types/application/json", "mimetype_inner": null, "name": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c8\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 WiFi \u2014 \u03a0\u03ac\u03c1\u03ba\u03bf - \u03a0\u03bb\u03b1\u03c4\u03b5\u03af\u03b1 \u03a0\u03b1\u03bb\u03bf\u03c5\u03bc\u03c0\u03b9\u03ce\u03c4\u03b7", "name_translated": {"el": "\u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 \u039c\u03ad\u03b3\u0